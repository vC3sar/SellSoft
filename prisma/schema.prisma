"generator client {\
  provider = \"prisma-client-js\"\
}\
\
datasource db {\
  provider = \"postgresql\"\
  url      = env(\"DATABASE_URL\")\
}\
\
model User {\
  id        String   @id @default(cuid())\
  email     String   @unique\
  name      String?\
  role      Role     @default(USER)\
  createdAt DateTime @default(now())\
  updatedAt DateTime @updatedAt\
  orders    Order[]\
}\
\
enum Role {\
  USER\
  ADMIN\
}\
\
model Category {\
  id        String    @id @default(cuid())\
  name      String    @unique\
  slug      String    @unique\
  products  Product[]\
  createdAt DateTime  @default(now())\
  updatedAt DateTime  @updatedAt\
}\
\
enum ProductType {\
  LICENSE\
  SOFTWARE\
}\
\
model Product {\
  id               String           @id @default(cuid())\
  name             String\
  slug             String           @unique\
  description      String\
  shortDescription String\
  images           String[]\
  categoryId       String?\
  category         Category?        @relation(fields: [categoryId], references: [id])\
  price            Float\
  type             ProductType\
  status           ProductStatus    @default(DRAFT)\
  digitalFileUrl   String?          // For SOFTWARE type (private url)\
  features         String[]\
  variants         ProductVariant[]\
  orders           OrderItem[]\
  createdAt        DateTime         @default(now())\
  updatedAt        DateTime         @updatedAt\
  License          License[]\
}\
\
enum ProductStatus {\
  DRAFT\
  ACTIVE\
  ARCHIVED\
}\
\
model ProductVariant {\
  id        String      @id @default(cuid())\
  productId String\
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)\
